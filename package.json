{
  "name": "speed-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Lector RSVP (speed reading) con palabra centrada y letra pivote en rojo. React + Node.",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "postinstall": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.2"
  }
}
